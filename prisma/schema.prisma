// Modele de donnees - Copilote IA de gestion - Atelier Brochant
// Reprend la section 15 "Donnees principales a stocker" du cahier des charges.
//
// PostgreSQL (section 16 : "Architecture technique cible"), y compris en
// developpement local, pour ne jamais tester sur un moteur different de la
// production. Voir README.md pour l'installation locale de PostgreSQL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Clients & facturation (source : Synec) ---------------------------------

model Client {
  id        String    @id @default(cuid())
  // Identifiant du client dans Synec : permet un import idempotent de
  // l'export clients, independamment de la correspondance par nom (qui
  // sert de repli pour les clients crees uniquement via l'import factures).
  synecId   String?   @unique
  nom       String
  email     String?
  telephone String?
  type      String? // Particulier | Entreprise | Syndic | SCI | Association...
  source    String? // GOOGLE | MAPS | PAGESJAUNES | Pas de source...
  adresse   String?
  codePostal String?
  ville     String?
  pays      String?
  notes     String?
  factures  Facture[]
  sourceImportId String?
  sourceImport   ImportBatch? @relation(fields: [sourceImportId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Facture {
  id                 String    @id @default(cuid())
  reference          String    @unique
  clientId           String?
  client             Client?   @relation(fields: [clientId], references: [id])
  clientNom          String
  description        String? // annotation_1 dans l'export Synec reel : nature de l'intervention
  dateEmission       DateTime?
  dateEcheance       DateTime?
  montantHT          Float?
  montantTTC         Float
  // Montant effectivement regle, reconstitue a partir de la colonne
  // "payments" de l'export Synec reel (une facture peut etre reglee en
  // plusieurs fois). Permet de calculer un "reste a percevoir" plutot
  // qu'un simple statut binaire.
  montantRegle       Float     @default(0)
  statut             String // "payee" | "partiellement_payee" | "impayee" | "cloturee"
  modePaiement       String?
  bonCommande        String?
  delaiAccordeJusqua DateTime? // cf. section 4.3 : delai accorde => suspension des relances
  financementOney    Boolean   @default(false) // cf. section 4.4
  clotureSynec       Boolean   @default(false)
  sourceImportId     String?
  sourceImport       ImportBatch? @relation(fields: [sourceImportId], references: [id])
  paiements          Paiement[]
  relances           Relance[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

// Trace des relances envoyees pour une facture impayee (section 4.3 : le
// moteur de regles determine QUAND relancer, l'envoi effectif reste un
// geste humain volontaire - voir src/services/relances.ts). Sert aussi de
// garde-fou anti-doublon : un palier deja envoye n'est jamais renvoye.
model Relance {
  id           String   @id @default(cuid())
  factureId    String
  facture      Facture  @relation(fields: [factureId], references: [id])
  palier       String // "rappel" | "relance" | "mise_en_demeure" (voir PALIERS_RELANCE)
  destinataire String // e-mail utilise au moment de l'envoi (trace meme si le client change d'adresse plus tard)
  createdAt    DateTime @default(now())
}

// --- Tresorerie : Stripe & banque (section 5) --------------------------------

model Paiement {
  id             String    @id @default(cuid())
  source         String // "stripe" | "banque" | "cheque" | "autre"
  paymentRef     String    @unique // identifiant Stripe du paiement
  brut           Float
  frais          Float     @default(0)
  net            Float
  devise         String    @default("EUR")
  date           DateTime
  clientEmail    String?
  // Description/libelle du paiement cote Stripe (quand disponible via
  // l'API) : sert a retrouver la reference d'un bon de commande citee par
  // le client au moment du paiement (section 4.4, "un bon de commande
  // paye par Stripe est reconnu comme paye"). Jamais rempli par l'import
  // CSV (absent de cet export), uniquement par la synchronisation directe.
  description    String?
  // Identifiant de payout Stripe (texte libre, pas de cle etrangere) :
  // le rapprochement se fait par requete applicative, pas a l'import, car
  // paiements et payouts peuvent arriver dans un ordre quelconque selon
  // le fichier CSV depose.
  payoutRef      String?
  factureId      String?
  facture        Facture?  @relation(fields: [factureId], references: [id])
  sourceImportId String?
  sourceImport   ImportBatch? @relation(fields: [sourceImportId], references: [id])
  createdAt      DateTime  @default(now())
}

model Payout {
  id                     String    @id @default(cuid())
  payoutRef              String    @unique // identifiant Stripe du payout
  date                   DateTime
  montantNet             Float
  statut                 String?
  // Nom de la banque destinataire et reference de l'ecriture Stripe
  // correspondante (colonnes "Destination Name" / "Balance Transaction" de
  // l'export reel) : utile pour rapprocher visuellement du releve bancaire.
  destinationName        String?
  balanceTransactionRef  String?
  // Idem : rapprochement avec MouvementBancaire fait par requete applicative.
  mouvementBancaireId    String?
  sourceImportId         String?
  sourceImport           ImportBatch? @relation(fields: [sourceImportId], references: [id])
  createdAt              DateTime  @default(now())
}

model MouvementBancaire {
  id                  String    @id @default(cuid())
  date                DateTime
  libelle             String
  debit               Float     @default(0)
  credit              Float     @default(0)
  montant             Float
  rapprochementStatut String    @default("non_rapproche") // non_rapproche | rapproche | a_verifier
  hashLigne           String    @unique
  sourceImportId      String?
  sourceImport        ImportBatch? @relation(fields: [sourceImportId], references: [id])
  createdAt           DateTime  @default(now())
}

// Ligne d'un recapitulatif de solde Stripe periodique (categorie deja
// agregee par Stripe : starting_balance, activity_gross, activity_fee,
// activity, payouts_gross, payouts_fee, payouts, ending_balance...).
// Sert de repere d'audit : ne remplace pas les paiements/payouts detailles.
model RecapitulatifSolde {
  id             String    @id @default(cuid())
  categorie      String
  libelle        String
  montantNet     Float
  devise         String    @default("EUR")
  sourceImportId String?
  sourceImport   ImportBatch? @relation(fields: [sourceImportId], references: [id])
  createdAt      DateTime  @default(now())

  @@unique([categorie, libelle])
}

// --- Fournisseurs & sous-traitants (section 6) -------------------------------

model Fournisseur {
  id             String    @id @default(cuid())
  nom            String    @unique
  modeReception  String? // "email" | "portail" | "comptant"
  portailUrl     String?
  modePaiement   String?
  prelevementLcr Boolean   @default(false)
  factures       FactureFournisseur[]
  documents      DocumentFournisseur[]
  createdAt      DateTime  @default(now())
}

model DocumentFournisseur {
  id             String    @id @default(cuid())
  fournisseurId  String?
  fournisseur    Fournisseur? @relation(fields: [fournisseurId], references: [id])
  type           String // "facture" | "avoir" | "bon_enlevement" | "releve" | "devis" | "ambigu" | "autre"
  fichierNom     String?
  numero         String?
  date           DateTime?
  montant        Float?
  statutDext     String    @default("non_envoye") // non_envoye | envoye | archive | a_valider
  hashFichier    String?   @unique
  // "ia" quand le type provient du filet de securite Claude (uniquement
  // pour les documents que les regles de mots-cles auraient laisses
  // "ambigu"), absent/null sinon (classification par regle deterministe,
  // le cas normal). Transparence explicite plutot qu'un match silencieux,
  // et permet de reconsiderer facilement ces cas si besoin.
  classifiePar   String?
  // Provenance Gmail (section 7 du cahier des charges), conservee pour
  // tracabilite. Pas de contrainte unique ici : un meme e-mail peut
  // contenir plusieurs pieces jointes, donc plusieurs documents. La
  // deduplication reelle (section 7.3) repose sur hashFichier, unique par
  // piece jointe quel que soit le message qui l'a apportee.
  gmailMessageId    String?
  gmailAttachmentId String? // avec gmailMessageId : permet de rappeler la piece jointe (previsualisation, envoi manuel vers Dext)
  mimeType          String?
  gmailExpediteur   String?
  gmailObjet        String?
  dateReceptionMail DateTime?
  createdAt      DateTime  @default(now())

  @@index([gmailMessageId])
}

// Connexion OAuth a une boite Gmail surveillee (section 7 : pipeline
// Gmail -> classification -> controle doublon -> Dext). Le jeton de
// rafraichissement est chiffre au repos (section 17 : "chiffrement des
// secrets"), jamais stocke en clair.
model GmailConnexion {
  id                  String    @id @default(cuid())
  compteEmail         String    @unique
  refreshTokenChiffre String
  scope               String?
  actif               Boolean   @default(true)
  connecteLe          DateTime  @default(now())
  derniereSynchro     DateTime?
  dernierHistoryId    String?
}

model FactureFournisseur {
  id            String    @id @default(cuid())
  fournisseurId String?
  fournisseur   Fournisseur? @relation(fields: [fournisseurId], references: [id])
  reference     String?
  echeance      DateTime?
  montant       Float
  modePaiement  String?
  statut        String    @default("a_payer") // a_payer | payee
  sousTraitant  Boolean   @default(false)
  createdAt     DateTime  @default(now())
}

// --- Memoire metier, controle et journal (sections 8, 12, 14) ---------------

model Decision {
  id        String    @id @default(cuid())
  type      String // "delai_accorde" | "exception" | "financement_oney" | "correction"
  motif     String?
  dateDebut DateTime  @default(now())
  dateFin   DateTime?
  auteur    String?
  objetType String?
  objetId   String?
  createdAt DateTime  @default(now())
}

model Anomalie {
  id             String    @id @default(cuid())
  type           String
  gravite        String    @default("moyenne") // faible | moyenne | haute
  preuves        String? // JSON serialise
  actionProposee String?
  statut         String    @default("a_valider") // a_valider | validee | ignoree
  createdAt      DateTime  @default(now())
}

model JournalEvenement {
  id         String   @id @default(cuid())
  horodatage DateTime @default(now())
  evenement  String
  action     String?
  resultat   String?
  details    String? // JSON serialise
}

// --- Prospection commerciale (cahier des charges "Outil de prospection") ---
//
// Module distinct de la gestion (sections 1 a 17 ci-dessus) : sourcing de
// prospects, mini-CRM, enrichissement email et campagnes d'envoi. Cible
// prioritaire au demarrage : syndics/gestionnaires et assurances de
// Seine-et-Marne (77), extension Ile-de-France ensuite (section 1).

model Prospect {
  id          String    @id @default(cuid())
  type        String // "syndic" | "assurance"
  entreprise  String
  contactNom  String?
  contactFonction String?
  email       String?
  // Estimation de fiabilite de l'email (0-100) posee par le module
  // d'enrichissement (verification MX + pattern), section 2.3. Permet de
  // prioriser/filtrer avant un envoi de masse plutot que de decouvrir les
  // adresses invalides via le taux de rebond.
  emailScoreFiabilite Int?
  emailSource String? // "import" | "manuel" | "enrichissement_pattern" | "enrichissement_hunter"
  telephone   String?
  siteWeb     String?
  adresse     String?
  codePostal  String?
  ville       String?
  marqueProposee String? // "france_degorgement" | "atelier_brochant"
  serviceCible   String?
  statut      String    @default("a_contacter") // a_contacter | contacte | relance | rdv | client | sans_suite
  notes       String?
  datePremierContact DateTime?
  dateDerniereRelance DateTime?
  // RGPD (section 3) : un prospect desinscrit n'est plus jamais inclus dans
  // un segment de campagne, quel que soit le filtre applique.
  desinscrit  Boolean   @default(false)
  dateDesinscription DateTime?
  source      String? // "sourcing_api" | "import_csv" | "import_excel" | "manuel"
  sourceImportId String?
  sourceImport   ProspectionImport? @relation(fields: [sourceImportId], references: [id])
  historiqueStatuts ProspectStatutChangement[]
  envois      EnvoiCampagne[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Dedoublonnage (section 2.1) : meme entreprise + meme email = meme fiche.
  @@unique([entreprise, email])
  @@index([type, statut])
  @@index([codePostal])
}

// Historique des changements de statut (section 2.2 : "avec historique des
// changements"), horodate independamment du champ statut/updatedAt du
// prospect qui ne garde que la valeur courante.
model ProspectStatutChangement {
  id           String   @id @default(cuid())
  prospectId   String
  prospect     Prospect @relation(fields: [prospectId], references: [id])
  ancienStatut String?
  nouveauStatut String
  auteur       String?
  createdAt    DateTime @default(now())
}

// Import de sourcing (CSV/Excel manuel, section 2.1) : rejoue le meme
// principe de tracabilite qu'ImportBatch pour la gestion, sans le
// reutiliser directement (schemas de colonnes et types de source distincts).
model ProspectionImport {
  id          String     @id @default(cuid())
  fichierNom  String
  hashFichier String     @unique
  dateImport  DateTime   @default(now())
  nbLignes    Int        @default(0)
  nbNouveaux  Int        @default(0)
  nbDoublons  Int        @default(0)
  nbErreurs   Int        @default(0)
  details     String? // JSON serialise (erreurs, avertissements)
  prospects   Prospect[]
}

// Modele de mail de campagne (section 2.4), variables remplacees a l'envoi
// (voir src/services/prospection/campagnes.ts) : {{contact}}, {{entreprise}},
// {{marque}}, {{service}}.
model EmailTemplate {
  id        String   @id @default(cuid())
  nom       String
  marque    String? // "france_degorgement" | "atelier_brochant"
  service   String?
  objet     String
  corpsHtml String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  campagnes Campagne[]
}

// Campagne d'envoi vers un segment de la base (section 2.4). Le filtre de
// segment est stocke tel quel (JSON) et reevalue a chaque envoi, plutot que
// de figer la liste des destinataires a la creation.
model Campagne {
  id              String   @id @default(cuid())
  nom             String
  templateId      String
  template        EmailTemplate @relation(fields: [templateId], references: [id])
  segmentFiltre   String // JSON : { type?, statut?, codePostal?, marqueProposee? }
  statut          String   @default("brouillon") // brouillon | en_cours | terminee
  relanceApresJours Int?   // ex. 7 : delai avant relance automatique (section 2.4)
  arretSiReponse  Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  envois          EnvoiCampagne[]
}

// Un envoi individuel (premier envoi ou relance) d'une campagne a un
// prospect, avec son suivi (section 2.5 : ouverture, clic, reponse,
// desinscription). tokenSuivi sert de cle publique (pixel d'ouverture, lien
// de clic, lien de desinscription) : jamais l'id interne, pour ne pas
// exposer les identifiants de la base dans les URLs d'un e-mail.
model EnvoiCampagne {
  id             String    @id @default(cuid())
  campagneId     String
  campagne       Campagne  @relation(fields: [campagneId], references: [id])
  prospectId     String
  prospect       Prospect  @relation(fields: [prospectId], references: [id])
  tokenSuivi     String    @unique @default(cuid())
  estRelance     Boolean   @default(false)
  gmailMessageId String?
  gmailThreadId  String?
  statut         String    @default("envoye") // envoye | ouvert | clique | repondu | rebond | desabonne | echec
  dateEnvoi      DateTime  @default(now())
  dateOuverture  DateTime?
  dateClic       DateTime?
  dateReponse    DateTime?
  createdAt      DateTime  @default(now())

  @@index([campagneId])
  @@index([prospectId])
}

// --- Reception des fichiers CSV ---------------------------------------------

model ImportBatch {
  id             String    @id @default(cuid())
  fichierNom     String
  typeDetecte    String // synec_factures | synec_clients | stripe_paiements | stripe_payouts | stripe_solde | banque_releve | banque_releve_pdf | inconnu
  hashFichier    String    @unique
  dateImport     DateTime  @default(now())
  nbLignes       Int       @default(0)
  nbNouveaux     Int       @default(0)
  nbDoublons     Int       @default(0)
  nbErreurs      Int       @default(0)
  statut         String    @default("ok") // ok | partiel | echec | type_inconnu
  details        String? // JSON serialise (erreurs, avertissements)
  factures       Facture[]
  clients        Client[]
  paiements      Paiement[]
  payouts        Payout[]
  mouvements     MouvementBancaire[]
  recapitulatifs RecapitulatifSolde[]
}
