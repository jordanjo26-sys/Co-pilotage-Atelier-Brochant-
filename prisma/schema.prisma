// Modele de donnees - Copilote IA de gestion - Atelier Brochant
// Reprend la section 15 "Donnees principales a stocker" du cahier des charges.
//
// PostgreSQL (section 16 : "Architecture technique cible"), y compris en
// developpement local, pour ne jamais tester sur un moteur different de la
// production. Voir README.md pour l'installation locale de PostgreSQL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Clients & facturation (source : Synec) ---------------------------------

model Client {
  id        String    @id @default(cuid())
  // Identifiant du client dans Synec : permet un import idempotent de
  // l'export clients, independamment de la correspondance par nom (qui
  // sert de repli pour les clients crees uniquement via l'import factures).
  synecId   String?   @unique
  nom       String
  email     String?
  telephone String?
  type      String? // Particulier | Entreprise | Syndic | SCI | Association...
  source    String? // GOOGLE | MAPS | PAGESJAUNES | Pas de source...
  adresse   String?
  codePostal String?
  ville     String?
  pays      String?
  notes     String?
  factures  Facture[]
  sourceImportId String?
  sourceImport   ImportBatch? @relation(fields: [sourceImportId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Facture {
  id                 String    @id @default(cuid())
  reference          String    @unique
  clientId           String?
  client             Client?   @relation(fields: [clientId], references: [id])
  clientNom          String
  description        String? // annotation_1 dans l'export Synec reel : nature de l'intervention
  dateEmission       DateTime?
  dateEcheance       DateTime?
  montantHT          Float?
  montantTTC         Float
  // Montant effectivement regle, reconstitue a partir de la colonne
  // "payments" de l'export Synec reel (une facture peut etre reglee en
  // plusieurs fois). Permet de calculer un "reste a percevoir" plutot
  // qu'un simple statut binaire.
  montantRegle       Float     @default(0)
  statut             String // "payee" | "partiellement_payee" | "impayee" | "cloturee"
  modePaiement       String?
  bonCommande        String?
  // Identifiant(s) PaymentIntent Stripe ("pi_...", separes par une virgule
  // si plusieurs reglements Stripe sur la meme facture), extraits de la
  // colonne "payments" de l'export Synec reel quand un reglement cite
  // explicitement Stripe (ex. "Stripe pi_3Qt9BJKxMN1fAYGf2gwFCzW5" en note -
  // voir parseReglements). Permet un rattachement exact (pas une simple
  // recherche de texte) avec le paiement correspondant dans Paiement.paymentIntentRef,
  // demande explicite de l'utilisateur (afficher client + numero de
  // facture a cote de chaque paiement Stripe).
  referencesStripe   String?
  delaiAccordeJusqua DateTime? // cf. section 4.3 : delai accorde => suspension des relances
  financementOney    Boolean   @default(false) // cf. section 4.4
  clotureSynec       Boolean   @default(false)
  sourceImportId     String?
  sourceImport       ImportBatch? @relation(fields: [sourceImportId], references: [id])
  paiements          Paiement[]
  relances           Relance[]
  encaissements      Encaissement[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

// Detail ligne a ligne de la colonne "payments" de l'export Synec (voir
// parseReglements) : une Facture peut etre reglee en plusieurs fois, parfois
// avec des modes differents (ex. 500€ en carte puis 437,43€ en cheque sur
// la meme facture) - Facture.modePaiement/montantRegle ne gardent que
// l'agrege (liste des modes, somme totale), insuffisant pour retrouver le
// montant encaisse PAR cheque sur une facture reglee en plusieurs fois.
// Reconstruit entierement a chaque import (voir importSynecFactures) :
// supprime puis recree pour la facture concernee plutot que fusionne, pour
// ne jamais dupliquer un encaissement deja importe.
model Encaissement {
  id        String   @id @default(cuid())
  factureId String
  facture   Facture  @relation(fields: [factureId], references: [id], onDelete: Cascade)
  date      DateTime?
  montant   Float
  mode      String
  note      String?
  // Rapprochement avec la remise carte bleue ("REMISE CB") qui a credite
  // ce reglement sur le compte (meme principe que
  // DocumentFournisseur.mouvementBancaireId : pas une vraie relation
  // Prisma, juste un identifiant pose par rapprochementBancaire.ts).
  // Plusieurs encaissements du meme jour partagent generalement le meme
  // mouvement (la remise regroupe tous les paiements carte d'une journee).
  mouvementBancaireId String?
  createdAt DateTime @default(now())

  @@index([factureId])
}

// Trace des relances envoyees pour une facture impayee (section 4.3 : le
// moteur de regles determine QUAND relancer, l'envoi effectif reste un
// geste humain volontaire - voir src/services/relances.ts). Sert aussi de
// garde-fou anti-doublon : un palier deja envoye n'est jamais renvoye.
model Relance {
  id           String   @id @default(cuid())
  factureId    String
  facture      Facture  @relation(fields: [factureId], references: [id])
  palier       String // "rappel" | "relance" | "mise_en_demeure" (voir PALIERS_RELANCE)
  destinataire String // e-mail utilise au moment de l'envoi (trace meme si le client change d'adresse plus tard)
  createdAt    DateTime @default(now())
}

// --- Tresorerie : Stripe & banque (section 5) --------------------------------

model Paiement {
  id             String    @id @default(cuid())
  source         String // "stripe" | "banque" | "cheque" | "autre"
  paymentRef     String    @unique // identifiant Stripe du paiement
  brut           Float
  frais          Float     @default(0)
  net            Float
  devise         String    @default("EUR")
  date           DateTime
  clientEmail    String?
  // Description/libelle du paiement cote Stripe (quand disponible via
  // l'API) : sert a retrouver la reference d'un bon de commande citee par
  // le client au moment du paiement (section 4.4, "un bon de commande
  // paye par Stripe est reconnu comme paye"). Jamais rempli par l'import
  // CSV (absent de cet export), uniquement par la synchronisation directe.
  description    String?
  // Moyen de paiement cote Stripe ("card_present" = Tap to Pay/terminal,
  // "card" = carte en ligne) : demande explicite de l'utilisateur de
  // distinguer les deux dans la liste des reglements Stripe. Rempli
  // uniquement par la synchronisation directe (payment_method_details.type
  // de la Charge Stripe, deja inclus dans l'objet source expanse - aucun
  // appel API supplementaire). Jamais rempli par l'import CSV.
  moyenPaiement  String?
  // Identifiant PaymentIntent Stripe ("pi_...") de la Charge, deja present
  // sur l'objet source expanse (aucun appel API supplementaire). Rempli
  // uniquement par la synchronisation directe. Sert a un rattachement
  // EXACT avec Facture.referencesStripe : Synec note deja cette meme
  // reference dans sa colonne "payments" quand le reglement vient de
  // Stripe (ex. "Stripe pi_3Qt9BJKxMN1fAYGf2gwFCzW5"), donc une simple
  // egalite d'identifiant suffit, bien plus fiable qu'une recherche de
  // texte dans la description (voir rapprochementFactures.ts).
  paymentIntentRef String?
  // Identifiant de payout Stripe (texte libre, pas de cle etrangere) :
  // le rapprochement se fait par requete applicative, pas a l'import, car
  // paiements et payouts peuvent arriver dans un ordre quelconque selon
  // le fichier CSV depose.
  payoutRef      String?
  factureId      String?
  facture        Facture?  @relation(fields: [factureId], references: [id])
  sourceImportId String?
  sourceImport   ImportBatch? @relation(fields: [sourceImportId], references: [id])
  createdAt      DateTime  @default(now())
}

model Payout {
  id                     String    @id @default(cuid())
  payoutRef              String    @unique // identifiant Stripe du payout
  date                   DateTime
  montantNet             Float
  statut                 String?
  // Nom de la banque destinataire et reference de l'ecriture Stripe
  // correspondante (colonnes "Destination Name" / "Balance Transaction" de
  // l'export reel) : utile pour rapprocher visuellement du releve bancaire.
  destinationName        String?
  balanceTransactionRef  String?
  // Idem : rapprochement avec MouvementBancaire fait par requete applicative.
  mouvementBancaireId    String?
  sourceImportId         String?
  sourceImport           ImportBatch? @relation(fields: [sourceImportId], references: [id])
  createdAt              DateTime  @default(now())
}

model MouvementBancaire {
  id                  String    @id @default(cuid())
  date                DateTime
  libelle             String
  debit               Float     @default(0)
  credit              Float     @default(0)
  montant             Float
  // Montant BRUT (avant commission bancaire) d'une remise carte bleue
  // ("REMISE CB"), quand le releve l'imprime (voir bankStatementPdf.ts) -
  // seul ce montant correspond a ce que les clients ont effectivement paye
  // (le montant net credite ci-dessus est deja ampute de la commission).
  // Necessaire pour rapprocher la remise des encaissements clients en
  // carte (voir Encaissement.mouvementBancaireId et rapprochementBancaire.ts).
  montantBrut         Float?
  rapprochementStatut String    @default("non_rapproche") // non_rapproche | rapproche | a_verifier
  hashLigne           String    @unique
  sourceImportId      String?
  sourceImport        ImportBatch? @relation(fields: [sourceImportId], references: [id])
  createdAt           DateTime  @default(now())
}

// Lien enrichi mouvement <-> facture(s) fournisseur (ArchiveComptable ou
// DocumentFournisseur), avec montant affecte - necessaire pour un reglement
// PARTIEL (le mouvement ne couvre qu'une partie de la facture) ou un
// reglement regroupant plusieurs factures (meme principe que les lots CB/
// cheques cote credit, mais avec un montant explicite par ligne plutot
// qu'un simple id partage). Les champs mouvementBancaireId simples sur
// ArchiveComptable/DocumentFournisseur restent inchanges et continuent de
// marquer le cas simple (1 facture = 1 mouvement, montant exact) - cette
// table est la source de verite uniquement pour les cas geres par cette
// table (partiel, multi-facture, ou rapprochement manuel), jamais une
// vraie relation Prisma vers MouvementBancaire (meme principe que
// DocumentFournisseur.mouvementBancaireId), verifiee par requete
// applicative.
model RapprochementLigne {
  id                  String   @id @default(cuid())
  mouvementBancaireId String
  cibleType           String // "archive_comptable" | "document_fournisseur"
  cibleId             String
  montantAffecte      Float
  origine             String // "auto_exact" | "manuel"
  auteur              String?
  createdAt           DateTime  @default(now())
  // Jamais de DELETE : une annulation renseigne ces deux champs plutot que
  // de supprimer la ligne (historique integral demande explicitement).
  annuleLe            DateTime?
  annulePar           String?

  @@index([mouvementBancaireId])
  @@index([cibleType, cibleId])
}

// Historique de chaque action de rapprochement (auto ou manuelle), meme
// principe que ProspectStatutChangement ci-dessous mais sur une entite
// distincte - demande explicite de l'utilisateur ("garder un historique de
// chaque rapprochement et de ses modifications").
model RapprochementHistorique {
  id                  String   @id @default(cuid())
  mouvementBancaireId String
  action              String // "rapproche_auto" | "rapproche_manuel" | "annule_manuel" | "ambigu"
  ancienStatut        String?
  nouveauStatut       String
  detail              String? // JSON texte : cibles, montants
  auteur              String?
  createdAt           DateTime @default(now())

  @@index([mouvementBancaireId])
}

// Validation mensuelle du rapprochement bancaire (section "Suivi mensuel") -
// demande explicite de l'utilisateur : "Termine et valide" (coche verte) doit
// etre un geste humain volontaire, jamais une simple consequence automatique
// de "100% des mouvements sont rapproches". Garde une photographie des
// compteurs au moment de la validation pour detecter un changement ulterieur
// (ex. un nouveau releve du meme mois importe apres coup) sans jamais
// ecraser silencieusement une validation deja donnee.
model ValidationMoisComptable {
  id                   String    @id @default(cuid())
  periode              String    @unique // "AAAA-MM"
  valide               Boolean   @default(true)
  auteur               String?
  createdAt            DateTime  @default(now())
  nbMouvementsAuMoment Int
  nbRapprochesAuMoment Int
  // Jamais de DELETE : une invalidation (detection de changement) renseigne
  // ces deux champs plutot que de supprimer la ligne.
  invalideLe           DateTime?
  invalideMotif        String?
}

// Ligne d'un recapitulatif de solde Stripe periodique (categorie deja
// agregee par Stripe : starting_balance, activity_gross, activity_fee,
// activity, payouts_gross, payouts_fee, payouts, ending_balance...).
// Sert de repere d'audit : ne remplace pas les paiements/payouts detailles.
model RecapitulatifSolde {
  id             String    @id @default(cuid())
  categorie      String
  libelle        String
  montantNet     Float
  devise         String    @default("EUR")
  sourceImportId String?
  sourceImport   ImportBatch? @relation(fields: [sourceImportId], references: [id])
  createdAt      DateTime  @default(now())

  @@unique([categorie, libelle])
}

// --- Fournisseurs & sous-traitants (section 6) -------------------------------

model Fournisseur {
  id             String    @id @default(cuid())
  nom            String    @unique
  modeReception  String? // "email" | "portail" | "comptant"
  portailUrl     String?
  modePaiement   String?
  prelevementLcr Boolean   @default(false)
  factures       FactureFournisseur[]
  documents      DocumentFournisseur[]
  createdAt      DateTime  @default(now())
}

model DocumentFournisseur {
  id             String    @id @default(cuid())
  fournisseurId  String?
  fournisseur    Fournisseur? @relation(fields: [fournisseurId], references: [id])
  type           String // "facture" | "avoir" | "bon_enlevement" | "releve" | "devis" | "ambigu" | "autre"
  fichierNom     String?
  numero         String?
  date           DateTime?
  montantHT      Float?
  montantTTC     Float?
  statutDext     String    @default("non_envoye") // non_envoye | envoye | archive | a_valider
  hashFichier    String?   @unique
  // "ia" quand le type provient du filet de securite Claude (uniquement
  // pour les documents que les regles de mots-cles auraient laisses
  // "ambigu"), absent/null sinon (classification par regle deterministe,
  // le cas normal). Transparence explicite plutot qu'un match silencieux,
  // et permet de reconsiderer facilement ces cas si besoin.
  classifiePar   String?
  // Provenance Gmail (section 7 du cahier des charges), conservee pour
  // tracabilite. Pas de contrainte unique ici : un meme e-mail peut
  // contenir plusieurs pieces jointes, donc plusieurs documents. La
  // deduplication reelle (section 7.3) repose sur hashFichier, unique par
  // piece jointe quel que soit le message qui l'a apportee.
  gmailMessageId    String?
  gmailAttachmentId String? // avec gmailMessageId : permet de rappeler la piece jointe (previsualisation, envoi manuel vers Dext)
  mimeType          String?
  gmailExpediteur   String?
  gmailObjet        String?
  dateReceptionMail DateTime?
  // Rapprochement avec un mouvement bancaire (meme principe que
  // FactureFournisseur.mouvementBancaireId ci-dessus, et pour la meme
  // raison : FactureFournisseur n'est jamais alimentee par aucun code actif,
  // les vraies factures fournisseurs - celles qui arrivent par Gmail/Dext -
  // vivent ici). Pas une vraie relation Prisma, juste un identifiant pose
  // par rapprochementBancaire.ts, verifie par requete applicative.
  mouvementBancaireId String?
  createdAt      DateTime  @default(now())
  // Document papier numerise depuis l'application (section "Scanner un
  // document papier") : chemin local du PDF genere (voir uploads/scans/,
  // .gitignore), rempli uniquement pour cette source puisqu'il n'existe
  // alors aucun message Gmail a redemander pour previsualiser le document
  // ou l'envoyer a Dext (a la difference de gmailMessageId/gmailAttachmentId
  // ci-dessus, qui couvrent la source Gmail).
  cheminFichier     String?

  @@index([gmailMessageId])
}

// Connexion OAuth a une boite Gmail surveillee (section 7 : pipeline
// Gmail -> classification -> controle doublon -> Dext). Le jeton de
// rafraichissement est chiffre au repos (section 17 : "chiffrement des
// secrets"), jamais stocke en clair.
model GmailConnexion {
  id                  String    @id @default(cuid())
  compteEmail         String    @unique
  refreshTokenChiffre String
  scope               String?
  actif               Boolean   @default(true)
  connecteLe          DateTime  @default(now())
  derniereSynchro     DateTime?
  dernierHistoryId    String?
}

// Marque un message Gmail comme entierement traite par synchroniserGmail
// (section 7), pour ne plus jamais le re-telecharger aux cycles suivants.
// Cause reelle, constatee en production, du depassement de quota Gmail
// persistant (bien au-dela d'une simple rafale) : la fenetre de recherche
// de 14 jours est volontairement re-balayee a chaque cycle (toutes les 5
// minutes) par construction (voir le commentaire dans gmailSync.ts), mais
// jusqu'ici la deduplication (hashFichier) n'intervenait qu'APRES avoir
// deja retelecharge chaque piece jointe (gmail.users.messages.get PUIS
// attachments.get, les deux appels couteux en quota) - aucune economie
// d'appel n'etait donc jamais realisee pour un message deja entierement
// connu. Cette table permet de sauter un message deja traite avant meme
// le premier appel couteux (messages.get), ce qui reduit le volume reel
// d'appels Gmail par cycle a uniquement les messages vraiment nouveaux.
model GmailMessageTraite {
  id             String   @id @default(cuid())
  gmailMessageId String   @unique
  traiteLe       DateTime @default(now())
}

model FactureFournisseur {
  id            String    @id @default(cuid())
  fournisseurId String?
  fournisseur   Fournisseur? @relation(fields: [fournisseurId], references: [id])
  reference     String?
  echeance      DateTime?
  montant       Float
  modePaiement  String?
  statut        String    @default("a_payer") // a_payer | payee
  sousTraitant  Boolean   @default(false)
  // Rapprochement avec un mouvement bancaire (meme principe que
  // Payout.mouvementBancaireId : pas une vraie relation Prisma, juste un
  // identifiant pose par rapprochementBancaire.ts, verifie par requete
  // applicative). Permet d'etendre le dossier comptable aux factures
  // fournisseurs payees par virement/prelevement, pas seulement aux
  // payouts Stripe.
  mouvementBancaireId String?
  createdAt     DateTime  @default(now())
}

// --- Memoire metier, controle et journal (sections 8, 12, 14) ---------------

model Decision {
  id        String    @id @default(cuid())
  type      String // "delai_accorde" | "exception" | "financement_oney" | "correction"
  motif     String?
  dateDebut DateTime  @default(now())
  dateFin   DateTime?
  auteur    String?
  objetType String?
  objetId   String?
  createdAt DateTime  @default(now())
}

model Anomalie {
  id             String    @id @default(cuid())
  type           String
  gravite        String    @default("moyenne") // faible | moyenne | haute
  preuves        String? // JSON serialise
  actionProposee String?
  statut         String    @default("a_valider") // a_valider | validee | ignoree
  createdAt      DateTime  @default(now())
}

model JournalEvenement {
  id         String   @id @default(cuid())
  horodatage DateTime @default(now())
  evenement  String
  action     String?
  resultat   String?
  details    String? // JSON serialise
}

// --- Prospection commerciale (cahier des charges "Outil de prospection") ---
//
// Module distinct de la gestion (sections 1 a 17 ci-dessus) : sourcing de
// prospects, mini-CRM, enrichissement email et campagnes d'envoi. Cible
// prioritaire au demarrage : syndics/gestionnaires et assurances de
// Seine-et-Marne (77), extension Ile-de-France ensuite (section 1).

model Prospect {
  id          String    @id @default(cuid())
  type        String // "syndic" | "assurance"
  entreprise  String
  contactNom  String?
  contactFonction String?
  email       String?
  // Estimation de fiabilite de l'email (0-100) posee par le module
  // d'enrichissement (verification MX + pattern), section 2.3. Permet de
  // prioriser/filtrer avant un envoi de masse plutot que de decouvrir les
  // adresses invalides via le taux de rebond.
  emailScoreFiabilite Int?
  emailSource String? // "import" | "manuel" | "enrichissement_pattern" | "enrichissement_hunter"
  telephone   String?
  siteWeb     String?
  adresse     String?
  codePostal  String?
  ville       String?
  marqueProposee String? // "france_degorgement" | "atelier_brochant"
  serviceCible   String?
  statut      String    @default("a_contacter") // a_contacter | contacte | relance | rdv | client | sans_suite
  notes       String?
  datePremierContact DateTime?
  dateDerniereRelance DateTime?
  // RGPD (section 3) : un prospect desinscrit n'est plus jamais inclus dans
  // un segment de campagne, quel que soit le filtre applique.
  desinscrit  Boolean   @default(false)
  dateDesinscription DateTime?
  source      String? // "sourcing_api" | "import_csv" | "import_excel" | "manuel"
  sourceImportId String?
  sourceImport   ProspectionImport? @relation(fields: [sourceImportId], references: [id])
  historiqueStatuts ProspectStatutChangement[]
  envois      EnvoiCampagne[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Dedoublonnage (section 2.1) : meme entreprise + meme email = meme fiche.
  @@unique([entreprise, email])
  @@index([type, statut])
  @@index([codePostal])
}

// Historique des changements de statut (section 2.2 : "avec historique des
// changements"), horodate independamment du champ statut/updatedAt du
// prospect qui ne garde que la valeur courante.
model ProspectStatutChangement {
  id           String   @id @default(cuid())
  prospectId   String
  prospect     Prospect @relation(fields: [prospectId], references: [id])
  ancienStatut String?
  nouveauStatut String
  auteur       String?
  createdAt    DateTime @default(now())
}

// Import de sourcing (CSV/Excel manuel, section 2.1) : rejoue le meme
// principe de tracabilite qu'ImportBatch pour la gestion, sans le
// reutiliser directement (schemas de colonnes et types de source distincts).
model ProspectionImport {
  id          String     @id @default(cuid())
  fichierNom  String
  hashFichier String     @unique
  dateImport  DateTime   @default(now())
  nbLignes    Int        @default(0)
  nbNouveaux  Int        @default(0)
  nbDoublons  Int        @default(0)
  nbErreurs   Int        @default(0)
  details     String? // JSON serialise (erreurs, avertissements)
  prospects   Prospect[]
}

// Modele de mail de campagne (section 2.4), variables remplacees a l'envoi
// (voir src/services/prospection/campagnes.ts) : {{contact}}, {{entreprise}},
// {{marque}}, {{service}}.
model EmailTemplate {
  id        String   @id @default(cuid())
  nom       String
  marque    String? // "france_degorgement" | "atelier_brochant"
  service   String?
  objet     String
  corpsHtml String
  // Plaquette commerciale (PDF/image) jointe a chaque envoi utilisant ce
  // modele. Fichier stocke hors du depot (uploads/prospection/, voir
  // .gitignore et src/services/prospection/pieceJointe.ts) : seul le chemin
  // est persiste en base.
  pieceJointeChemin String?
  pieceJointeNom    String? // nom d'origine, affiche dans l'interface et a l'envoi
  pieceJointeType   String? // type MIME
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  campagnes Campagne[]
}

// Campagne d'envoi vers un segment de la base (section 2.4). Le filtre de
// segment est stocke tel quel (JSON) et reevalue a chaque envoi, plutot que
// de figer la liste des destinataires a la creation.
model Campagne {
  id              String   @id @default(cuid())
  nom             String
  templateId      String
  template        EmailTemplate @relation(fields: [templateId], references: [id])
  segmentFiltre   String // JSON : { type?, statut?, codePostal?, marqueProposee? }
  statut          String   @default("brouillon") // brouillon | en_cours | terminee
  relanceApresJours Int?   // ex. 7 : delai avant relance automatique (section 2.4)
  arretSiReponse  Boolean  @default(true)
  // Envoi sans geste humain (premier envoi comme relance), demande
  // explicitement par l'exploitant - voir l'en-tete de campagnes.ts pour le
  // garde-fou de quota qui s'applique quel que soit ce reglage. Desactive
  // par defaut : une campagne nouvellement creee reste manuelle tant que ce
  // champ n'est pas active explicitement depuis l'interface.
  automatique     Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  envois          EnvoiCampagne[]
}

// Un envoi individuel (premier envoi ou relance) d'une campagne a un
// prospect, avec son suivi (section 2.5 : ouverture, clic, reponse,
// desinscription). tokenSuivi sert de cle publique (pixel d'ouverture, lien
// de clic, lien de desinscription) : jamais l'id interne, pour ne pas
// exposer les identifiants de la base dans les URLs d'un e-mail.
model EnvoiCampagne {
  id             String    @id @default(cuid())
  campagneId     String
  campagne       Campagne  @relation(fields: [campagneId], references: [id])
  prospectId     String
  prospect       Prospect  @relation(fields: [prospectId], references: [id])
  tokenSuivi     String    @unique @default(cuid())
  estRelance     Boolean   @default(false)
  gmailMessageId String?
  gmailThreadId  String?
  statut         String    @default("envoye") // envoye | ouvert | clique | repondu | rebond | desabonne | echec
  dateEnvoi      DateTime  @default(now())
  dateOuverture  DateTime?
  dateClic       DateTime?
  dateReponse    DateTime?
  createdAt      DateTime  @default(now())

  @@index([campagneId])
  @@index([prospectId])
}

// --- Reception des fichiers CSV ---------------------------------------------

model ImportBatch {
  id             String    @id @default(cuid())
  fichierNom     String
  typeDetecte    String // synec_factures | synec_clients | stripe_paiements | stripe_payouts | stripe_solde | banque_releve | banque_releve_pdf | banque_releve_pdf_amex | google_ads_campagnes | inconnu
  hashFichier    String    @unique
  dateImport     DateTime  @default(now())
  nbLignes       Int       @default(0)
  nbNouveaux     Int       @default(0)
  nbDoublons     Int       @default(0)
  nbErreurs      Int       @default(0)
  statut         String    @default("ok") // ok | partiel | echec | type_inconnu
  details        String? // JSON serialise (erreurs, avertissements)
  factures       Facture[]
  clients        Client[]
  paiements      Paiement[]
  payouts        Payout[]
  mouvements     MouvementBancaire[]
  recapitulatifs RecapitulatifSolde[]
  campagnesAds   CampagneAdsImport[]
}

// --- Standard telephonique IA ------------------------------------------------

// Un appel recu par l'agent telephonique (Twilio -> /telephonie/*), quand
// l'utilisateur ne decroche pas. "conversation" garde l'historique exact
// echange avec Claude (blocs de reflexion compris, a renvoyer tels quels
// d'un tour a l'autre) ; "transcription" la version lisible destinee a
// l'e-mail de compte rendu.
model Appel {
  id              String    @id @default(cuid())
  callSid         String    @unique
  numeroAppelant  String?
  statut          String    @default("en_cours") // en_cours | termine
  conversation    Json      @default("[]")
  transcription   Json      @default("[]")
  // Propos de l'appelant non encore traites (echec ou delai depasse cote IA
  // au tour precedent) : reinjectes au tour suivant plutot que perdus.
  enAttente       String?
  silences        Int       @default(0)
  erreurs         Int       @default(0)
  // Message structure releve par l'agent (outil enregistrer_message).
  nom             String?
  telephone       String?
  adresse         String? // numero et rue
  codePostal      String?
  ville           String?
  typeLogement    String? // maison | appartement
  etage           String?
  codeAcces       String? // code d'immeuble / interphone
  motif           String?
  urgence         String? // faible | normale | urgente
  rendezVousDebut DateTime?
  rendezVousFin   DateTime?
  rendezVousEventId String?
  enregistrementUrl String? // messagerie de secours si l'IA est indisponible
  smsUrgenceEnvoyeLe DateTime?
  notifieLe       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// --- Mails importants (demande utilisateur : repérer par e-mail les
// demandes d'intervention/urgences noyées dans la boîte Gmail, au lieu
// d'attendre le récapitulatif du soir) --------------------------------------

// Garde la trace de chaque mail deja examine par la detection horaire, pour
// ne jamais le reclasser (et donc jamais le re-signaler) a chaque passage -
// meme principe d'idempotence que la deduplication par hash de
// DocumentFournisseur.
model MailExamine {
  id             String   @id @default(cuid())
  gmailMessageId String   @unique
  important      Boolean
  createdAt      DateTime @default(now())
}

// --- Demandes d'intervention prises par telephone (saisie manuelle) -------
//
// Demande utilisateur : remplace la prise de note papier puis la double
// saisie dans Synec par une fiche structuree, directement depuis le
// telephone. Ne pousse rien automatiquement dans Synec (qui n'a pas d'API) :
// reste une file d'attente "a saisir" tant que l'automatisation du cote
// ecriture de Synec n'existe pas.
model DemandeIntervention {
  id           String    @id @default(cuid())
  nom          String
  telephone    String?
  email        String?
  adresse      String?
  codePostal   String?
  ville        String?
  typeLogement String? // maison | appartement
  occupation   String? // proprietaire | locataire
  etage        String?
  codeAcces    String?
  motif        String?
  urgence      String? // faible | normale | urgente
  dateSouhaitee DateTime?
  dateSouhaiteeFin DateTime?
  sourceAcquisition String? // google | pages_jaunes | maps
  categorie    String? // plomberie | serrurerie | electricite | assainissement
  statut       String    @default("a_saisir") // a_saisir | saisie
  saisieLe     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// --- Google Ads : import manuel en attendant l'acces API (section ----------
// discutee avec l'utilisateur : l'API Google Ads ne renvoie encore aucune
// donnee, "Acces Explorer" en attente de validation par Google) -------------
//
// Palliatif volontairement simple : chaque depot d'export CSV Google Ads
// remplace la photographie precedente (pas de deduplication ligne a ligne,
// contrairement aux factures) - Morgane lit toujours le dernier lot importe.
// Bascule automatiquement vers l'API live (src/services/googleAds.ts) des
// qu'elle renvoie des donnees, sans rien a changer ici.
model CampagneAdsImport {
  id              String      @id @default(cuid())
  nom             String
  statut          String?
  type            String?
  budgetQuotidien Float?
  impressions     Int?
  clics           Int?
  cout            Float?
  conversions     Float?
  ctr             Float?
  cpcMoyen        Float?
  sourceImportId  String
  sourceImport    ImportBatch @relation(fields: [sourceImportId], references: [id])
  createdAt       DateTime    @default(now())
}

// Proposition d'action sur une campagne Google Ads, formulee par Morgane
// apres discussion avec l'utilisateur (demande explicite : Morgane ne doit
// jamais agir directement sur une campagne, seulement proposer - voir
// l'ecran de validation dedie dans l'app, distinct de la conversation).
//
// "creer_campagne" (phase 2) : campagneId reste vide tant que la campagne
// n'existe pas encore (rempli apres application reussie, pour pouvoir
// ensuite la retrouver/l'analyser). Les champs budgetQuotidien/urlFinale/
// titres/descriptions/motsCles/motsClesExclus ne sont utilises que par ce
// type - vides pour pause_campagne/reactiver_campagne. Campagne TOUJOURS
// creee en PAUSE par securite (demande explicite de l'utilisateur) :
// l'utilisateur doit l'activer lui-meme dans Google Ads apres verification.
model PropositionAds {
  id              String    @id @default(cuid())
  type            String // "pause_campagne" | "reactiver_campagne" | "creer_campagne" | "ajouter_mots_cles_exclus" | "pause_mot_cle" | "reactiver_mot_cle" | "exclure_action_conversion" | "creer_action_conversion_site" | "modifier_budget_campagne" | "ajouter_mots_cles_positifs" | "ajouter_extensions_campagne" | "modifier_strategie_encheres" | "definir_horaires_campagne" | "ajouter_audiences_campagne" | "ajouter_annonce_test" | "supprimer_campagne" | "ajuster_encheres_appareil" | "ajouter_groupe_annonces" | "modifier_annonce"
  campagneId      String // identifiant Google Ads de la campagne (campaign.id) ; vide pour une proposition de creation pas encore appliquee
  campagneNom     String
  justification   String // explication de Morgane, affichee a l'utilisateur sur l'ecran de validation
  budgetQuotidien Float? // euros/jour, pour "creer_campagne" (budget initial) et "modifier_budget_campagne" (nouveau budget)
  urlFinale       String? // page de destination des annonces, uniquement pour "creer_campagne"
  titres          String[] @default([]) // titres d'annonce (3 a 15), uniquement pour "creer_campagne"
  descriptions    String[] @default([]) // descriptions d'annonce (2 a 4), uniquement pour "creer_campagne"
  motsCles        String[] @default([]) // mots-cles pertinents, pour "creer_campagne" et "ajouter_mots_cles_positifs"
  motsClesExclus  String[] @default([]) // mots-cles exclus (negatifs), pour "creer_campagne" et "ajouter_mots_cles_exclus"
  groupeId        String? // ad_group.id : requis en entree pour "pause_mot_cle"/"reactiver_mot_cle"/"ajouter_mots_cles_positifs"/"ajouter_annonce_test" ; rempli APRES coup pour "ajouter_groupe_annonces" (le groupe n'existe pas encore au depot de la proposition)
  adId            String? // ad_group_ad.ad.id de l'annonce existante a completer, requis pour "modifier_annonce"
  nomGroupe       String? // nom du nouveau groupe d'annonces, requis pour "ajouter_groupe_annonces"
  criterionId     String? // ad_group_criterion.criterion_id, requis pour "pause_mot_cle"/"reactiver_mot_cle"
  motCleTexte     String? // texte du mot-cle, affichage uniquement, pour "pause_mot_cle"/"reactiver_mot_cle"
  conversionActionId String? // conversion_action.id, requis pour "exclure_action_conversion" ; rempli apres creation reussie pour "creer_action_conversion_site"
  typeConversionSite String? // "CLICK_TO_CALL" | "WEBPAGE", requis pour "creer_action_conversion_site"
  ciblesGeographiques String[] @default([]) // noms de lieux (ex. "Île-de-France", "Seine-et-Marne") a resoudre via Google puis cibler, uniquement pour "creer_campagne"
  numeroTelephone String? // pour l'extension d'appel creee avec la campagne, uniquement pour "creer_campagne"
  typeCorrespondance String? // "EXACT" | "PHRASE" | "BROAD", pour "creer_campagne" et "ajouter_mots_cles_positifs" (defaut PHRASE si absent)
  sitelinks       Json? // [{texte, description1?, description2?, url?}], pour "creer_campagne" et "ajouter_extensions_campagne"
  callouts        String[] @default([]) // textes courts (1 a 25 caracteres), pour "creer_campagne" et "ajouter_extensions_campagne"
  structuredSnippets Json? // [{header, valeurs: string[]}], pour "creer_campagne" et "ajouter_extensions_campagne"
  strategieEncheres String? // "MAXIMIZE_CONVERSIONS" | "TARGET_CPA" | "MANUAL_CPC", pour "creer_campagne" et "modifier_strategie_encheres" (defaut MAXIMIZE_CONVERSIONS si absent)
  cpaCibleEuros   Float? // cout par acquisition cible en euros, requis si strategieEncheres = "TARGET_CPA"
  horaires        Json? // [{jour, heureDebut, minuteDebut?, heureFin, minuteFin?}], pour "creer_campagne" et "definir_horaires_campagne"
  audiences       String[] @default([]) // noms de centres d'interet a rechercher puis attacher (signal d'observation), pour "creer_campagne" et "ajouter_audiences_campagne"
  ajustementsAppareil Json? // [{appareil: "MOBILE"|"TABLET"|"DESKTOP", pourcentage}], requis (au moins un) pour "ajuster_encheres_appareil"
  statut          String    @default("en_attente") // "en_attente" | "acceptee" | "refusee" | "appliquee" | "echec"
  erreur          String? // detail si l'application a echoue (statut "echec")
  creeLe          DateTime  @default(now())
  decideLe        DateTime?
}

// --- Module Reseaux sociaux (Facebook/Instagram) -----------------------
// Phase "fondations" : connexion Meta, creation/publication de posts avec
// photo, memes principes de securite que Google Ads (OAuth, secrets
// chiffres, aucune publication sans validation explicite de l'utilisateur
// sur un ecran dedie - jamais directement depuis la conversation).

model ConnexionMeta {
  id                         String    @id @default(cuid())
  pageId                     String    @unique
  pageNom                    String
  pageAccessTokenChiffre     String // jeton longue duree de la Page, chiffre au repos (voir cipher.ts)
  instagramBusinessAccountId String? // absent si seule la Page Facebook est utilisable (pas de compte Instagram professionnel lie)
  instagramUsername          String?
  actif                      Boolean   @default(true)
  connecteLe                 DateTime  @default(now())
}

model PropositionPost {
  id                     String    @id @default(cuid())
  plateformes            String[] // "FACEBOOK" et/ou "INSTAGRAM"
  texte                  String // legende/texte du post
  cheminMedia            String? // chemin sous public/media-publics/, requis pour Instagram (texte seul impossible sur ce reseau)
  justification          String // explication (de Morgane ou de l'utilisateur), affichee sur l'ecran de validation
  statut                 String    @default("en_attente") // "en_attente" | "acceptee" | "refusee" | "appliquee" | "echec"
  erreur                 String?
  idPublicationFacebook  String?
  idPublicationInstagram String?
  creeLe                 DateTime  @default(now())
  decideLe               DateTime?
}

// PagesJaunes/Solocal Manager n'offre aucune API publique (confirme par
// recherche) et son SSO (sso.solocal.com) bloque explicitement les
// navigateurs automatises (Cloudflare "security verification", constate en
// conditions reelles) - toute automatisation de connexion serait une
// tentative de contournement d'une protection anti-bot volontaire, exclue.
// Mode "assiste" a la place : Morgane redige, l'utilisateur colle lui-meme
// dans Solocal Manager puis marque publie ici. Pas de statut
// "appliquee"/"echec" (pas de publication automatique possible). Un seul
// etablissement existe pour ce module (117 avenue du General Leclerc, 77400
// Lagny-sur-Marne - valeur fixe, plus a redemander).
// Meme principe que PropositionAds : un seul modele, un discriminant "type"
// (actualite | info_fiche | reponse_avis) et des champs optionnels propres a
// chaque type plutot que trois tables quasi identiques.
model PropositionPagesJaunes {
  id             String    @id @default(cuid())
  type           String // "actualite" | "info_fiche" | "reponse_avis"
  etablissement  String    @default("A.B Atelier Brochant - 117 avenue du Général Leclerc, 77400 Lagny-sur-Marne")
  texte          String // actualite : texte publie ; info_fiche : contenu propose pour le champ ; reponse_avis : reponse proposee a l'avis
  cheminMedia    String? // actualite uniquement, chemin sous public/media-publics/ (reutilise l'upload du module Reseaux sociaux)
  champFiche     String? // info_fiche uniquement : "description" | "services" | "horaires" | "autre"
  avisClientNom  String? // reponse_avis uniquement, optionnel (visible sur l'avis transmis par l'utilisateur)
  avisNote       Int? // reponse_avis uniquement, optionnel (1 a 5)
  avisTexte      String? // reponse_avis uniquement : texte EXACT de l'avis transmis par l'utilisateur (jamais invente)
  justification  String
  statut         String    @default("en_attente") // "en_attente" | "acceptee" | "refusee" | "publiee"
  creeLe         DateTime  @default(now())
  decideLe       DateTime?
  publieeLe      DateTime?
}

// --- Module Realisations (galerie photos pour les prestataires externes) ---
// Demande explicite de l'utilisateur (novembre 2026) : il envoyait a la main
// par WhatsApp des photos de chantiers a deux prestataires externes (Google
// Maps/avis, site/referencement), chacun ne devant recevoir que les photos
// de son propre corps de metier (les deux marques deja geres dans Synec,
// "Atelier Brochant" et "France Degorgement"). Une ActiviteRealisation par
// marque, avec sa propre adresse e-mail (modifiable dans l'application,
// jamais a redeployer pour la changer) et son propre jeton de galerie
// (page publique sans mot de passe, le prestataire externe n'ayant pas les
// identifiants du site - voir /galerie-realisations/:token et l'exception
// nginx dediee dans bootstrap.sh).
model ActiviteRealisation {
  id                     String             @id @default(cuid())
  nom                    String             @unique // "Atelier Brochant" | "France Dégorgement"
  email                  String
  tokenGalerie           String             @unique
  derniereDigestEnvoyeeLe DateTime?
  photos                 PhotoRealisation[]
  createdAt              DateTime           @default(now())
}

model PhotoRealisation {
  id          String              @id @default(cuid())
  activiteId  String
  activite    ActiviteRealisation @relation(fields: [activiteId], references: [id])
  fichierNom  String // chemin relatif sous public/media-publics/realisations/
  chantierNom String?
  createdAt   DateTime            @default(now())
}

// --- Module Comptabilite (archive de factures independante de Dext) -----
// Demande explicite de l'utilisateur (novembre 2026) : apres un changement
// de comptable, l'ancien a supprime toutes les factures sur Dext - il ne
// restait qu'un export manuel (PDF/JPEG, plusieurs centaines de fichiers)
// fait avant la suppression. Ce module est volontairement SEPARE du
// circuit "Factures fournisseurs" (DocumentFournisseur, alimente par
// Gmail) : c'est une archive de secours pour un controle fiscal, importee
// en une fois depuis un ZIP, jamais envoyee a Dext ni reliee a un
// fournisseur Prisma existant (le nom tape/extrait suffit pour filtrer).
// Fichiers stockes hors du depot git, comme les autres uploads (voir
// services/archiveComptable.ts, dossier uploads/archives-comptables/).
model ArchiveComptable {
  id             String    @id @default(cuid())
  fichierNom     String // nom original du fichier dans le ZIP importe
  cheminFichier  String // chemin disque reel (uploads/archives-comptables/...)
  mimeType       String
  fournisseurNom String? // jamais devine pour un PDF illisible : laisse vide, a completer a la main
  numero         String?
  dateFacture    DateTime?
  montantHT      Float?
  montantTTC     Float?
  statut         String   @default("a_verifier") // "a_verifier" | "complete" - purement indicatif (champ manquant), jamais bloquant
  classifiePar   String? // "ia" si au moins un champ a ete propose par l'IA (transparence, meme principe que DocumentFournisseur.classifiePar)
  categorie      String? // categorie comptable (voir CATEGORIES_FACTURE dans archiveComptableIA.ts) - classement automatique, toujours corrigeable a la main
  createdAt      DateTime  @default(now())
  // Rapprochement avec un mouvement bancaire (meme principe que
  // DocumentFournisseur.mouvementBancaireId ci-dessus) - demande explicite
  // de l'utilisateur : certains fournisseurs recurrents (EDF, Bouygues
  // Telecom...) ne passent jamais par Gmail/Dext, seulement par ce module
  // (facture telechargee directement en PDF), donc jamais rapproches sans
  // cette passe dediee. Pas une vraie relation Prisma, juste un identifiant
  // pose par rapprochementBancaire.ts, verifie par requete applicative.
  mouvementBancaireId String?
  // Provenance reelle de la ligne (ecran unifie "Factures fournisseurs", V2) :
  // "dext_copie" (copie automatique d'un DocumentFournisseur envoye a Dext,
  // voir archiverFactureEnvoyeeDext) | "zip_manuel" (import ZIP/fichiers
  // manuel) | "ovh_api" (synchronisation OVHcloud). NULL = ligne anterieure a
  // ce marqueur, provenance non reclassee avec certitude (voir la migration
  // 20261122160000_archive_comptable_origine). Seule "dext_copie" est exclue
  // de la liste unifiee : deja representee par son DocumentFournisseur.
  origine               String?
  // Identifiant du DocumentFournisseur source quand origine="dext_copie".
  // Pas une vraie relation Prisma (meme principe que mouvementBancaireId).
  documentFournisseurId String?
}

// --- Module Visio (devis a distance) -------------------------------------
// Demande explicite de l'utilisateur : un client appelle sans rendez-vous
// sur place et veut un devis a distance. Visio a sens unique (l'utilisateur
// voit le client, jamais l'inverse - garanti par construction cote code,
// aucune piste camera n'est jamais publiee pour l'utilisateur, voir
// src/services/visio.ts), avec capture d'ecran a la demande et mesure
// optionnelle par calibration manuelle sur une capture. Aucun modele
// "Devis" n'existe dans cette base (les devis sont crees directement dans
// Synec, logiciel tiers sans API) : une session visio est donc autonome,
// son seul resultat durable est le PDF recapitulatif genere a partir des
// captures. Meme principe de jeton public imprevisible que
// ActiviteRealisation/tokenGalerie ci-dessus (page /visio-client/:token,
// sans mot de passe site - exception nginx dediee dans bootstrap.sh).
model SessionVisio {
  id              String         @id @default(cuid())
  clientNom       String
  clientTelephone String?
  token           String         @unique
  // "en_attente" (creee, personne connecte) | "en_cours" | "terminee"
  statut          String         @default("en_attente")
  livekitRoom     String         @unique
  dateDebut       DateTime?
  dateFin         DateTime?
  captures        CaptureVisio[]
  createdAt       DateTime       @default(now())
}

model CaptureVisio {
  id        String       @id @default(cuid())
  sessionId String
  session   SessionVisio @relation(fields: [sessionId], references: [id])
  // Chemin relatif sous uploads/visio/ (hors depot git, comme
  // uploads/scans - voir documentsScannes.ts).
  fichierNom String
  // JSON {referencePoints, referenceLongueurCm, mesurePoints,
  // distanceCalculeeCm} si une mesure a ete faite sur cette capture, sinon
  // absent (la mesure est occasionnelle, pas systematique - demande
  // explicite de l'utilisateur).
  mesures   String?
  createdAt DateTime     @default(now())
}
