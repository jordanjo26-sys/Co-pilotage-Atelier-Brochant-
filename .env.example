# Copier ce fichier en .env et l'adapter.

# Base de donnees PostgreSQL (section 16 du cahier des charges), y compris
# en developpement local (voir README.md pour l'installer). Adapter
# utilisateur/mot de passe/nom de base a votre installation.
DATABASE_URL="postgresql://copilote:changez-moi@localhost:5432/copilote_brochant"

# Base utilisee par "npm test" (schema recree a chaque lancement des tests,
# donc jamais la meme base que DATABASE_URL). Optionnel : a defaut, les
# tests utilisent DATABASE_URL avec "_test" ajoute au nom de la base.
# TEST_DATABASE_URL="postgresql://copilote:changez-moi@localhost:5432/copilote_brochant_test"

# Port d'ecoute du serveur HTTP
PORT=3000

# Cle de chiffrement au repos des secrets (jeton Gmail notamment).
# Generer une fois avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# et ne JAMAIS la commiter ni la faire circuler par un canal non securise.
ENCRYPTION_KEY=

# Connexion Gmail (section 7 et 17 du cahier des charges) : identifiants
# obtenus dans Google Cloud Console > API et services > Identifiants,
# apres avoir active l'API Gmail et configure l'ecran de consentement OAuth.
# GOOGLE_REDIRECT_URI doit correspondre exactement a une URI de redirection
# autorisee sur ce client OAuth, ex. https://votre-domaine/auth/google/callback
# (ou http://localhost:3000/auth/google/callback en developpement).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Interrupteur de securite (section 16) : transfert automatique des
# factures reconnues vers Dext. "false" met les factures de cote (etiquette
# Gmail par mois de reception, statut "a_valider") pour un envoi manuel
# groupe, le temps d'observer le comportement du systeme. Par defaut
# (absent ou toute valeur autre que "false"), le transfert est actif.
DEXT_AUTO_FORWARD=true

# Heure (0-23, heure locale du serveur) d'envoi du recapitulatif quotidien
# par e-mail a la boite Gmail connectee. Par defaut 19 (19h) si absent.
DAILY_RECAP_HOUR=19

# Cle API Anthropic (https://console.anthropic.com), pour Morgane
# (assistante IA conversationnelle, Phase 7 du cahier des charges). Absente,
# Morgane repond une erreur explicite plutot que de faire planter le reste
# de l'application.
ANTHROPIC_API_KEY=

# Cle API Stripe **restreinte, lecture seule** (paiements/payouts) pour la
# synchronisation directe par API, en remplacement du depot manuel d'export
# CSV Stripe. Jamais la cle secrete complete du compte (section 17,
# moindre privilege). Absente, la section Stripe reste desactivee et
# l'import CSV manuel continue de fonctionner normalement.
STRIPE_API_KEY=
